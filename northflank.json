{
  "$schema": "https://api.northflank.com/v1/schemas/template",
  "apiVersion": "v1.2",
  "arguments": {
    "COPIA_BUCKET": "",
    "COPIA_CHAVE_PUBLICA": "",
    "COPIA_AWS_ACCESS_KEY_ID": "",
    "COPIA_AWS_SECRET_ACCESS_KEY": "",
    "REMOCOES_BUCKET": "",
    "REMOCOES_AWS_ACCESS_KEY_ID": "",
    "REMOCOES_AWS_SECRET_ACCESS_KEY": ""
  },
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "kind": "Project",
          "ref": "projeto",
          "spec": {
            "name": "caixa-simples",
            "description": "Hospeda o sistema de caixa e vendas.",
            "region": "southamerica-east"
          }
        },
        {
          "kind": "Workflow",
          "spec": {
            "type": "sequential",
            "context": {
              "projectId": "${refs.projeto.id}"
            },
            "steps": [
              {
                "kind": "ReleaseStage",
                "ref": "producao",
                "spec": {
                  "name": "producao",
                  "position": 0
                }
              },
              {
                "kind": "Workflow",
                "spec": {
                  "type": "parallel",
                  "steps": [
                    {
                      "kind": "Addon",
                      "ref": "banco",
                      "spec": {
                        "name": "banco",
                        "description": "Guarda os dados do sistema no PostgreSQL.",
                        "stageId": "${refs.producao.id}",
                        "type": "postgresql",
                        "version": "17",
                        "billing": {
                          "deploymentPlan": "nf-compute-20",
                          "storage": 4096,
                          "replicas": 1
                        },
                        "tlsEnabled": true,
                        "externalAccessEnabled": false,
                        "customCredentials": {
                          "dbName": "caixa_simples"
                        },
                        "backupSchedules": []
                      }
                    },
                    {
                      "kind": "BuildService",
                      "ref": "buildAplicacao",
                      "spec": {
                        "name": "build-aplicacao",
                        "description": "Monta a imagem da API e do aplicativo.",
                        "stageId": "${refs.producao.id}",
                        "billing": {
                          "buildPlan": "nf-compute-200-8"
                        },
                        "disabledCI": true,
                        "vcsData": {
                          "projectType": "github",
                          "projectUrl": "https://github.com/Elias-Costa/caixa-simples"
                        },
                        "buildSettings": {
                          "dockerfile": {
                            "buildEngine": "buildkit",
                            "dockerFilePath": "/Dockerfile",
                            "dockerWorkDir": "/",
                            "buildkit": {
                              "useCache": false
                            }
                          }
                        },
                        "buildConfiguration": {
                          "branchRestrictions": ["main"],
                          "prRestrictions": []
                        }
                      }
                    },
                    {
                      "kind": "BuildService",
                      "ref": "buildCopia",
                      "spec": {
                        "name": "build-copia",
                        "description": "Monta a imagem do job de backup cifrado.",
                        "stageId": "${refs.producao.id}",
                        "billing": {
                          "buildPlan": "nf-compute-200-8"
                        },
                        "disabledCI": true,
                        "vcsData": {
                          "projectType": "github",
                          "projectUrl": "https://github.com/Elias-Costa/caixa-simples"
                        },
                        "buildSettings": {
                          "dockerfile": {
                            "buildEngine": "buildkit",
                            "dockerFilePath": "/operacao/copia/Dockerfile",
                            "dockerWorkDir": "/operacao",
                            "buildkit": {
                              "useCache": false
                            }
                          }
                        },
                        "buildConfiguration": {
                          "branchRestrictions": ["main"],
                          "prRestrictions": []
                        }
                      }
                    }
                  ]
                }
              },
              {
                "kind": "Workflow",
                "spec": {
                  "type": "parallel",
                  "steps": [
                    {
                      "kind": "Build",
                      "ref": "imagemAplicacao",
                      "condition": "success",
                      "spec": {
                        "id": "${refs.buildAplicacao.id}",
                        "type": "service",
                        "branch": "main"
                      }
                    },
                    {
                      "kind": "Build",
                      "ref": "imagemCopia",
                      "condition": "success",
                      "spec": {
                        "id": "${refs.buildCopia.id}",
                        "type": "service",
                        "branch": "main"
                      }
                    },
                    {
                      "kind": "Condition",
                      "spec": {
                        "kind": "Addon",
                        "spec": {
                          "type": "running",
                          "data": {
                            "addonId": "${refs.banco.id}",
                            "timeoutDuration": 1800
                          }
                        }
                      }
                    }
                  ]
                }
              },
              {
                "kind": "SecretGroup",
                "ref": "segredosAplicacao",
                "spec": {
                  "name": "segredos-aplicacao",
                  "description": "Guarda a chave dos tokens e o acesso ao banco.",
                  "type": "secret",
                  "secretType": "environment",
                  "priority": 10,
                  "restrictions": {
                    "restricted": true,
                    "nfObjects": [
                      { "id": "caixa-simples", "type": "service" },
                      { "id": "seed", "type": "job" }
                    ]
                  },
                  "addonDependencies": [
                    {
                      "addonId": "${refs.banco.id}",
                      "keys": [
                        { "keyName": "JDBC_POSTGRES_URI", "aliases": ["CAIXA_SIMPLES_DB_URL"] },
                        { "keyName": "USERNAME", "aliases": ["CAIXA_SIMPLES_DB_USER"] },
                        { "keyName": "PASSWORD", "aliases": ["CAIXA_SIMPLES_DB_PASSWORD"] }
                      ]
                    }
                  ],
                  "secrets": {
                    "variables": {
                      "CAIXA_SIMPLES_JWT_SECRET": "${fn.randomSecret(64)}"
                    },
                    "files": {}
                  }
                }
              },
              {
                "kind": "SecretGroup",
                "ref": "segredosPix",
                "updateMode": "create",
                "spec": {
                  "name": "segredos-pix-efi",
                  "description": "Guarda os dados de acesso ao provedor Pix de cada Conta.",
                  "type": "secret",
                  "secretType": "environment",
                  "priority": 10,
                  "restrictions": {
                    "restricted": true,
                    "nfObjects": [
                      { "id": "caixa-simples", "type": "service" }
                    ]
                  },
                  "secrets": {
                    "variables": {},
                    "files": {}
                  }
                }
              },
              {
                "kind": "SecretGroup",
                "ref": "segredosCopia",
                "spec": {
                  "name": "segredos-copia",
                  "description": "Guarda o acesso ao banco e ao armazenamento de backup.",
                  "type": "secret",
                  "secretType": "environment",
                  "priority": 10,
                  "restrictions": {
                    "restricted": true,
                    "nfObjects": [
                      { "id": "copia", "type": "job" }
                    ]
                  },
                  "addonDependencies": [
                    {
                      "addonId": "${refs.banco.id}",
                      "keys": [
                        { "keyName": "POSTGRES_URI", "aliases": ["CAIXA_SIMPLES_COPIA_BANCO"] }
                      ]
                    }
                  ],
                  "secrets": {
                    "variables": {
                      "CAIXA_SIMPLES_COPIA_CHAVE_PUBLICA": "${args.COPIA_CHAVE_PUBLICA}",
                      "CAIXA_SIMPLES_COPIA_DESTINO": "s3:${args.COPIA_BUCKET}/horaria",
                      "CAIXA_SIMPLES_COPIA_DESTINO_DIARIA": "s3:${args.COPIA_BUCKET}/diaria",
                      "CAIXA_SIMPLES_COPIA_HORA_DIARIA": "6",
                      "RCLONE_CONFIG_S3_TYPE": "s3",
                      "RCLONE_CONFIG_S3_PROVIDER": "AWS",
                      "RCLONE_CONFIG_S3_REGION": "sa-east-1",
                      "RCLONE_CONFIG_S3_ACCESS_KEY_ID": "${args.COPIA_AWS_ACCESS_KEY_ID}",
                      "RCLONE_CONFIG_S3_SECRET_ACCESS_KEY": "${args.COPIA_AWS_SECRET_ACCESS_KEY}"
                    },
                    "files": {}
                  }
                }
              },
              {
                "kind": "SecretGroup",
                "ref": "segredosRemocoes",
                "spec": {
                  "name": "segredos-remocoes",
                  "description": "Guarda o acesso de gravação ao registro externo de remoções.",
                  "type": "secret",
                  "secretType": "environment",
                  "priority": 10,
                  "restrictions": {
                    "restricted": true,
                    "nfObjects": [
                      { "id": "caixa-simples", "type": "service" }
                    ]
                  },
                  "secrets": {
                    "variables": {
                      "CAIXA_SIMPLES_REMOCOES_BUCKET": "${args.REMOCOES_BUCKET}",
                      "AWS_ACCESS_KEY_ID": "${args.REMOCOES_AWS_ACCESS_KEY_ID}",
                      "AWS_SECRET_ACCESS_KEY": "${args.REMOCOES_AWS_SECRET_ACCESS_KEY}"
                    },
                    "files": {}
                  }
                }
              },
              {
                "kind": "Workflow",
                "spec": {
                  "type": "parallel",
                  "steps": [
                    {
                      "kind": "DeploymentService",
                      "ref": "servico",
                      "spec": {
                        "name": "caixa-simples",
                        "description": "Serve a API e o aplicativo na mesma origem.",
                        "stageId": "${refs.producao.id}",
                        "billing": {
                          "deploymentPlan": "nf-compute-50"
                        },
                        "deployment": {
                          "instances": 1,
                          "internal": {
                            "id": "${refs.buildAplicacao.id}",
                            "branch": "main",
                            "buildId": "${refs.imagemAplicacao.id}"
                          },
                          "releaseFlowControlled": true,
                          "docker": {
                            "configType": "default"
                          }
                        },
                        "ports": [
                          {
                            "name": "http",
                            "internalPort": 8080,
                            "public": true,
                            "protocol": "HTTP"
                          }
                        ],
                        "runtimeEnvironment": {
                          "CAIXA_SIMPLES_PORT": "8080"
                        },
                        "healthChecks": [
                          {
                            "protocol": "HTTP",
                            "type": "startupProbe",
                            "port": 8080,
                            "path": "/actuator/health/liveness",
                            "initialDelaySeconds": 20,
                            "periodSeconds": 10,
                            "timeoutSeconds": 3,
                            "failureThreshold": 30
                          },
                          {
                            "protocol": "HTTP",
                            "type": "readinessProbe",
                            "port": 8080,
                            "path": "/actuator/health/readiness",
                            "initialDelaySeconds": 1,
                            "periodSeconds": 10,
                            "timeoutSeconds": 3,
                            "failureThreshold": 3,
                            "successThreshold": 1
                          },
                          {
                            "protocol": "HTTP",
                            "type": "livenessProbe",
                            "port": 8080,
                            "path": "/actuator/health/liveness",
                            "initialDelaySeconds": 1,
                            "periodSeconds": 30,
                            "timeoutSeconds": 5,
                            "failureThreshold": 3
                          }
                        ]
                      }
                    },
                    {
                      "kind": "ManualJob",
                      "ref": "jobSeed",
                      "spec": {
                        "name": "seed",
                        "description": "Cria uma Conta em uma tarefa avulsa.",
                        "stageId": "${refs.producao.id}",
                        "billing": {
                          "deploymentPlan": "nf-compute-50"
                        },
                        "backoffLimit": 0,
                        "activeDeadlineSeconds": 600,
                        "runOnSourceChange": "never",
                        "deployment": {
                          "internal": {
                            "id": "${refs.buildAplicacao.id}",
                            "branch": "main",
                            "buildId": "${refs.imagemAplicacao.id}"
                          },
                          "releaseFlowControlled": true,
                          "docker": {
                            "configType": "default"
                          }
                        },
                        "runtimeEnvironment": {
                          "SPRING_PROFILES_ACTIVE": "seed",
                          "SPRING_MAIN_WEB_APPLICATION_TYPE": "none"
                        }
                      }
                    },
                    {
                      "kind": "CronJob",
                      "ref": "jobCopia",
                      "spec": {
                        "name": "copia",
                        "description": "Envia um backup cifrado do banco a cada hora.",
                        "stageId": "${refs.producao.id}",
                        "billing": {
                          "deploymentPlan": "nf-compute-10"
                        },
                        "schedule": "0 * * * *",
                        "concurrencyPolicy": "forbid",
                        "backoffLimit": 1,
                        "activeDeadlineSeconds": 1800,
                        "runOnSourceChange": "never",
                        "deployment": {
                          "internal": {
                            "id": "${refs.buildCopia.id}",
                            "branch": "main",
                            "buildId": "${refs.imagemCopia.id}"
                          },
                          "releaseFlowControlled": true,
                          "docker": {
                            "configType": "default"
                          }
                        }
                      }
                    }
                  ]
                }
              },
              {
                "kind": "WorkflowTemplate",
                "ref": "publicacao",
                "spec": {
                  "apiVersion": "v1.2",
                  "name": "publicacao",
                  "description": "Monta e publica as imagens do commit validado.",
                  "stageId": "${template.refs.producao.id}",
                  "arguments": {
                    "sha": ""
                  },
                  "options": {
                    "concurrencyPolicy": "queue"
                  },
                  "triggers": [
                    {
                      "kind": "webhook",
                      "ref": "ci",
                      "spec": {}
                    }
                  ],
                  "spec": {
                    "kind": "Workflow",
                    "spec": {
                      "type": "sequential",
                      "steps": [
                        {
                          "kind": "Workflow",
                          "spec": {
                            "type": "parallel",
                            "steps": [
                              {
                                "kind": "Build",
                                "ref": "aplicacao",
                                "condition": "success",
                                "spec": {
                                  "id": "${template.refs.buildAplicacao.id}",
                                  "type": "service",
                                  "branch": "main",
                                  "sha": "${args.sha}"
                                }
                              },
                              {
                                "kind": "Build",
                                "ref": "copia",
                                "condition": "success",
                                "spec": {
                                  "id": "${template.refs.buildCopia.id}",
                                  "type": "service",
                                  "branch": "main",
                                  "sha": "${args.sha}"
                                }
                              }
                            ]
                          }
                        },
                        {
                          "kind": "Workflow",
                          "spec": {
                            "type": "parallel",
                            "steps": [
                              {
                                "kind": "Release",
                                "spec": {
                                  "type": "build",
                                  "origin": {
                                    "id": "${template.refs.buildAplicacao.id}",
                                    "branch": "main",
                                    "build": "${refs.aplicacao.id}"
                                  },
                                  "target": {
                                    "id": "${template.refs.servico.id}",
                                    "type": "service"
                                  }
                                }
                              },
                              {
                                "kind": "Release",
                                "spec": {
                                  "type": "build",
                                  "origin": {
                                    "id": "${template.refs.buildAplicacao.id}",
                                    "branch": "main",
                                    "build": "${refs.aplicacao.id}"
                                  },
                                  "target": {
                                    "id": "${template.refs.jobSeed.id}",
                                    "type": "job"
                                  }
                                }
                              },
                              {
                                "kind": "Release",
                                "spec": {
                                  "type": "build",
                                  "origin": {
                                    "id": "${template.refs.buildCopia.id}",
                                    "branch": "main",
                                    "build": "${refs.copia.id}"
                                  },
                                  "target": {
                                    "id": "${template.refs.jobCopia.id}",
                                    "type": "job"
                                  }
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
